<odoo>
    <record id="view_product_form_inherit_substitute" model="ir.ui.view">
        <field name="name">product.product.form.substitute</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <sheet>
            <notebook>
                <page name="substitutes_lines" string="Productos substitutos">
                 <group>
                    <field name="allow_mix_substitutes"/>
                </group>

                    <field name="delivery_substitute_line_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="substitute_product_id" 
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="substitute_code"/>
                            <field name="substitute_name"/>
                            <field name="substitute_qty_available"/>
                        </tree>
                    </field>
                    
                </page>
            </notebook>
            </sheet>
        </field>
    </record>
</odoo>